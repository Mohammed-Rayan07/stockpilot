# Neon POOLED connection string, from the Neon dashboard's Connect dialog. Used by the app at runtime (lib/db/index.ts).
DATABASE_URL=

# Neon DIRECT (unpooled) connection string, same dialog. Used by drizzle-kit migrations only.
DATABASE_URL_UNPOOLED=

# Google Gemini API key, from https://aistudio.google.com/apikey. Server-only; never referenced from a client component.
GEMINI_API_KEY=

# This app's own absolute origin, e.g. http://localhost:3000 or https://stockpilot.vercel.app. Compared against every mutating request's Origin header (lib/auth/origin.ts).
APP_ORIGIN=

# development | production. Set automatically by next dev / next build / Vercel; only needed here if a script outside that lifecycle reads it.
NODE_ENV=

# No secret may ever be prefixed NEXT_PUBLIC_ - anything so prefixed is compiled
# into the client bundle and is public.
