# Neon POOLED connection string. Used by the app at runtime (lib/db/index.ts).
DATABASE_URL=

# Neon DIRECT (unpooled) connection string. Used by drizzle-kit migrations only.
DATABASE_URL_UNPOOLED=

# Google Gemini API key. Server-only; never referenced from a client component.
GEMINI_API_KEY=

# Absolute origin of the deployed app, e.g. https://stockpilot.vercel.app
# Mutating requests must carry a matching Origin header (lib/auth/origin.ts).
APP_ORIGIN=http://localhost:3000

NODE_ENV=development

# No secret may ever be prefixed NEXT_PUBLIC_ - anything so prefixed is compiled
# into the client bundle and is public.
